---
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dossier Técnico Corporativo | EC Ingeniería</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@600;700&family=Montserrat:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      @page {
        size: A4 portrait;
        margin: 10mm;
      }
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #081C36;
        background: #ffffff;
        margin: 0;
        padding: 0;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Montserrat', sans-serif;
      }
      .font-mono-tech {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="max-w-[210mm] mx-auto px-4 py-2 text-[11px] leading-snug">
    <!-- Top Corporate Header -->
    <header class="flex items-center justify-between pb-3 mb-3 border-b-2 border-[#081C36]">
      <div class="flex items-center gap-3">
        <img src="/assets/logo.webp" alt="EC Ingeniería" class="h-12 w-auto object-contain" />
      </div>
      <div class="text-right text-[10.5px] text-slate-600 space-y-0.5">
        <div class="font-heading font-extrabold text-xs text-[#081C36] uppercase tracking-wider">
          DOSSIER TÉCNICO CORPORATIVO // EC INGENIERÍA
        </div>
        <div>Alcance Operativo: <strong class="text-[#081C36]">Cobertura Nacional, Chile</strong></div>
        <div>Licitaciones y Proyectos: <strong class="text-[#F07218] font-mono-tech">contacto@ecingenieria.cl</strong></div>
        <div>Teléfono & WhatsApp Corporativo: <strong class="text-[#081C36] font-mono-tech">+56 9 2093 7495</strong></div>
      </div>
    </header>

    <!-- Hero Banner -->
    <section class="rounded-xl bg-[#081C36] text-white p-5 mb-4 relative overflow-hidden">
      <div class="relative z-10">
        <div class="text-[9.5px] font-mono-tech font-bold uppercase tracking-widest text-[#F07218] mb-1">
          PRESENTACIÓN EJECUTIVA • CONTRATISTA EPC DE INGENIERÍA, MONTAJE Y MANTENIMIENTO INDUSTRIAL
        </div>
        <h1 class="font-heading font-extrabold text-lg text-white leading-tight mb-2">
          Obras de Ingeniería Industrial, Estructuras, Piping y Montaje Electromecánico
        </h1>
        <p class="text-[10.5px] text-slate-200 leading-relaxed">
          En <strong>EC Ingeniería</strong> ejecutamos proyectos integrales desde la ingeniería de detalle y prefabricación en maestranza hasta el montaje en faena, pruebas pre-operacionales y Puesta en Marcha (PEM), garantizando estándar Cero Daño (HSE), aseguramiento de calidad trazable (QA/QC) y cumplimiento estricto de plazos en todo Chile.
        </p>

        <div class="grid grid-cols-4 gap-2.5 mt-3.5 pt-3 border-t border-white/15 text-center">
          <div class="bg-white/10 rounded-lg py-1.5 px-2">
            <div class="font-heading font-extrabold text-xs text-[#F07218]">+15 Años</div>
            <div class="text-[9px] text-slate-200">Trayectoria Industrial</div>
          </div>
          <div class="bg-white/10 rounded-lg py-1.5 px-2">
            <div class="font-heading font-extrabold text-xs text-[#F07218]">100% HSE</div>
            <div class="text-[9px] text-slate-200">Estándar Cero Daño</div>
          </div>
          <div class="bg-white/10 rounded-lg py-1.5 px-2">
            <div class="font-heading font-extrabold text-xs text-[#F07218]">+120 Obras</div>
            <div class="text-[9px] text-slate-200">Ejecutadas en Chile</div>
          </div>
          <div class="bg-white/10 rounded-lg py-1.5 px-2">
            <div class="font-heading font-extrabold text-xs text-[#F07218]">QA / QC</div>
            <div class="text-[9px] text-slate-200">Dossier & As-Built</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 Specialties Grid -->
    <section class="mb-4">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="w-1.5 h-4 bg-[#F07218] rounded-sm"></span>
        <h2 class="font-heading font-extrabold text-xs uppercase tracking-wider text-[#081C36]">
          1. Divisiones de Especialidad Técnica y Normativa
        </h2>
      </div>

      <div class="grid grid-cols-2 gap-2.5">
        <div class="p-2.5 rounded-lg border border-slate-200 bg-slate-50/70">
          <div class="font-heading font-extrabold text-[11px] text-[#081C36]">01. Ingeniería y Desarrollo de Proyectos</div>
          <p class="text-[10px] text-slate-600 mt-0.5">
            Levantamientos críticos 3D/CAD, memorias de cálculo (NCh 2369), planos de fabricación/montaje y cubicaciones EPC/EPCM.
          </p>
        </div>
        <div class="p-2.5 rounded-lg border border-slate-200 bg-slate-50/70">
          <div class="font-heading font-extrabold text-[11px] text-[#081C36]">02. Montaje Industrial y Electromecánico</div>
          <p class="text-[10px] text-slate-600 mt-0.5">
            Montaje y alineamiento láser de bombas, chancadores, reductores, correas transportadoras, chutes, harneros y Rigging certificado.
          </p>
        </div>
        <div class="p-2.5 rounded-lg border border-slate-200 bg-slate-50/70">
          <div class="font-heading font-extrabold text-[11px] text-[#081C36]">03. Fabricación y Montaje de Estructuras</div>
          <p class="text-[10px] text-slate-600 mt-0.5">
            Naves industriales, pipe racks, plataformas y pasarelas bajo norma AWS D1.1, ensayos END, granallado SSPC-SP10 y pintura epóxica/PU.
          </p>
        </div>
        <div class="p-2.5 rounded-lg border border-slate-200 bg-slate-50/70">
          <div class="font-heading font-extrabold text-[11px] text-[#081C36]">04. Piping y Redes de Incendio NFPA</div>
          <p class="text-[10px] text-slate-600 mt-0.5">
            Spools en acero carbono, inoxidable y HDPE (ASME B31.3), redes húmedas/secas contra incendio NFPA 13/14/20/24 y pruebas hidrostáticas.
          </p>
        </div>
        <div class="p-2.5 rounded-lg border border-slate-200 bg-slate-50/70">
          <div class="font-heading font-extrabold text-[11px] text-[#081C36]">05. Electricidad e Instrumentación (E&I)</div>
          <p class="text-[10px] text-slate-600 mt-0.5">
            Salas eléctricas, tableros CCM, escalerillas EPC, conduit ANSI, calibración de instrumentación y protocolos bajo pliegos RIC SEC.
          </p>
        </div>
        <div class="p-2.5 rounded-lg border border-slate-200 bg-slate-50/70">
          <div class="font-heading font-extrabold text-[11px] text-[#081C36]">06. Mantenimiento y Paradas de Planta</div>
          <p class="text-[10px] text-slate-600 mt-0.5">
            Contratos de mantenimiento preventivo/correctivo, paradas de planta (Shutdowns), bloqueo LOTO y respuesta operacional 24/7.
          </p>
        </div>
      </div>
    </section>

    <!-- Representative Projects Table -->
    <section class="mb-4">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="w-1.5 h-4 bg-[#F07218] rounded-sm"></span>
        <h2 class="font-heading font-extrabold text-xs uppercase tracking-wider text-[#081C36]">
          2. Experiencia Representativa y Estándares de Obra
        </h2>
      </div>

      <table class="w-full border-collapse text-[10px]">
        <thead>
          <tr class="bg-[#081C36] text-white text-left font-heading">
            <th class="py-1.5 px-2.5 rounded-tl-lg">Proyecto / Obra</th>
            <th class="py-1.5 px-2.5">Ubicación</th>
            <th class="py-1.5 px-2.5">Especialidad y Magnitud</th>
            <th class="py-1.5 px-2.5 rounded-tr-lg">Normativa Aplicada</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 border border-slate-200">
          <tr>
            <td class="py-1.5 px-2.5 font-bold text-[#081C36]">Planta de Proceso Minero</td>
            <td class="py-1.5 px-2.5">Catemu (2025)</td>
            <td class="py-1.5 px-2.5">340 Ton Estructura • 820 m Piping de Proceso</td>
            <td class="py-1.5 px-2.5 font-bold text-[#F07218] font-mono-tech">AWS D1.1 / ASME B31.3</td>
          </tr>
          <tr class="bg-slate-50">
            <td class="py-1.5 px-2.5 font-bold text-[#081C36]">Red de Incendio Industrial</td>
            <td class="py-1.5 px-2.5">Mejillones (2024)</td>
            <td class="py-1.5 px-2.5">1.450 m Cañería SCH 40 • Sala de Bombas</td>
            <td class="py-1.5 px-2.5 font-bold text-[#F07218] font-mono-tech">NFPA 14 / 20 / 24</td>
          </tr>
          <tr>
            <td class="py-1.5 px-2.5 font-bold text-[#081C36]">Montaje de Estructuras Metálicas</td>
            <td class="py-1.5 px-2.5">Antofagasta (2023)</td>
            <td class="py-1.5 px-2.5">480 Ton Acero Estructural • Nave 3.200 m²</td>
            <td class="py-1.5 px-2.5 font-bold text-[#F07218] font-mono-tech">NCh 2369 / AWS D1.1</td>
          </tr>
          <tr class="bg-slate-50">
            <td class="py-1.5 px-2.5 font-bold text-[#081C36]">Sistema Transporte de Mineral</td>
            <td class="py-1.5 px-2.5">Los Andes (2024)</td>
            <td class="py-1.5 px-2.5">650 m Correa Overland • 4 Chutes y Motriz</td>
            <td class="py-1.5 px-2.5 font-bold text-[#F07218] font-mono-tech">CEMA / DS 132 Minería</td>
          </tr>
          <tr>
            <td class="py-1.5 px-2.5 font-bold text-[#081C36]">Canalizaciones E&I y Salas CCM</td>
            <td class="py-1.5 px-2.5">Quintero (2024)</td>
            <td class="py-1.5 px-2.5">2.100 m EPC/Conduit • 85 Lazos de Control</td>
            <td class="py-1.5 px-2.5 font-bold text-[#F07218] font-mono-tech">SEC Pliegos RIC / ISA</td>
          </tr>
          <tr class="bg-slate-50">
            <td class="py-1.5 px-2.5 font-bold text-[#081C36]">Parada de Planta y Alineamiento</td>
            <td class="py-1.5 px-2.5">Rancagua (2025)</td>
            <td class="py-1.5 px-2.5">Shutdown 72h • Overhaul 12 Equipos Críticos</td>
            <td class="py-1.5 px-2.5 font-bold text-[#F07218] font-mono-tech">ISO 10816 / ASME / LOTO</td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- Footer Contact Banner (Pure Company Name — EC Ingeniería) -->
    <footer class="mt-4 pt-3 border-t-2 border-[#081C36] flex items-center justify-between text-[10px] text-slate-600">
      <div>
        <strong class="text-[#081C36] font-heading">EC INGENIERÍA</strong> • Ingeniería, Proyectos, Montaje y Mantenimiento Industrial<br />
        Gerencia de Ingeniería y Licitaciones: <span class="text-[#F07218] font-bold font-mono-tech">contacto@ecingenieria.cl</span> • <strong class="font-mono-tech text-[#081C36]">+56 9 2093 7495</strong>
      </div>
      <div class="text-right font-heading font-bold text-[#081C36]">
        Cobertura Nacional • Chile
      </div>
    </footer>
  </body>
</html>
