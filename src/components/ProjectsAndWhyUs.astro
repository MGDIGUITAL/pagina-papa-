    deliverables: [
      "Montaje de escalerillas (EPC), tubería conduit ANSI C80.1 y cajas NEMA 4X",
      "Tendido, conectorizado y pruebas de aislación (Megger) de alimentadores",
      "Instalación y calibración de transmisores de presión, flujo y temperatura",
      "Pruebas de lazo punto a punto (Loop Check) e integración a sistema SCADA/PLC"
    ]
  },
  {
    id: "proy-rancagua",
    code: "OBRA-06",
    title: "Parada de Planta y Alineamiento",
    location: "Rancagua, 2025",
    image: "/assets/proyecto-6.webp",
    category: "Mantenimiento Industrial",
    filterTag: "mantenimiento",
    featured: false,
    clientType: "Planta Concentradora Minera",
    metrics: "Shutdown 72 Horas • 12 Equipos",
    norm: "ISO 10816 / ASME / LOTO",
    hse: "14.400 HH Sin Accidentes CTP",
    scope: "Ejecución de parada de planta programada (Shutdown): overhaul de bombas de pulpa de gran caudal, cambio de spools de desgaste y alineamiento láser.",
    deliverables: [
      "Desmontaje seguro bajo protocolo de bloqueo LOTO de equipos rotatorios",
      "Reemplazo de rodete, carcasa y sellos mecánicos en bombas de impulsión",
