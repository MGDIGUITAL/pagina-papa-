    location: "Catemu, 2025",
    image: "/assets/proyecto-1.webp",
    category: "Minería y Procesos",
    filterTag: "mineria",
    featured: true,
    clientType: "Compañía Minera Zona Central",
    metrics: "340 Ton Estructura • 820 m Piping",
    norm: "AWS D1.1 / ASME B31.3",
    hse: "42.000 HH Sin Accidentes CTP",
    scope: "Montaje electromecánico integral, fabricación y montaje de estructuras metálicas de soporte, plataformas de operación normadas y piping de proceso en acero carbono e inoxidable.",
