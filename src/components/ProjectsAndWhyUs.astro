  },
  {
    id: "proy-mejillones",
    code: "OBRA-02",
    title: "Red de Incendio Industrial",
    location: "Mejillones, 2024",
    image: "/assets/proyecto-2.webp",
    category: "Piping & Red NFPA",
    filterTag: "piping",
    featured: true,
    clientType: "Terminal Industrial & Energético",
    metrics: "1.450 m Cañería SCH 40 • Sala Bombas",
    norm: "NFPA 14 / NFPA 20 / NFPA 24",
    hse: "28.500 HH Sin Accidentes CTP",
    scope: "Ingeniería de detalle, prefabricación de spools en maestranza, montaje de anillo contra incendios bajo código NFPA y pruebas hidrostáticas certificadas a 200 PSI.",
    deliverables: [
      "Prefabricación, granallado SSPC-SP10 y pintura epóxica roja RAL 3000 de spools",
      "Montaje de colectores, válvulas OS&Y, postes indicadores (PIV) y monitores",
      "Integración de sala de bombas contra incendio diésel/eléctrica y bomba jockey",
      "Pruebas hidrostáticas a 200 PSI, lavado interno (flushing) y acta de recepción"
    ]
  },
  {
    id: "proy-antofagasta",
    code: "OBRA-03",
    title: "Montaje de Estructuras",
    location: "Antofagasta, 2023",
    image: "/assets/proyecto-3.webp",
    category: "Estructuras Metálicas",
    filterTag: "estructuras",
    featured: true,
    clientType: "Complejo Industrial Logístico Minero",
    metrics: "480 Ton Acero Estructural • 3.200 m²",
    norm: "NCh 2369 / AWS D1.1",
    hse: "35.000 HH Sin Accidentes CTP",
    scope: "Fabricación en maestranza, pre-armado e izaje pesado de naves industriales, columnas de alma llena y racks de cañerías de alto tonelaje.",
    deliverables: [
      "Fabricación de columnas, vigas maestras y costaneras con control dimensional",
      "Maniobras de izaje con grúas telescópicas y planes de Rigging certificados",
      "Torqueo controlado de uniones empernadas de alta resistencia ASTM A325",
      "Inspección ultrasónica (UT) y tintas penetrantes (PT) en uniones críticas"
    ]
  },
  {
    id: "proy-losandes",
    code: "OBRA-04",
    title: "Sistema de Transporte de Mineral",
    location: "Los Andes, 2024",
    image: "/assets/proyecto-4.webp",
    category: "Montaje Electromecánico",
    filterTag: "mineria",
    featured: false,
    clientType: "Operación Gran Minería del Cobre",
    metrics: "650 m Correa Overland • 4 Chutes",
    norm: "CEMA / ISO 9001 / DS 132",
    hse: "51.200 HH Sin Accidentes CTP",
    scope: "Montaje electromecánico integral de galería de correas transportadoras, estaciones motrices, reductores, chutes de transferencia y harneros vibratorios.",
    deliverables: [
      "Montaje estructural de mesas de polines, estaciones de impacto y retorno",
      "Instalación y alineamiento láser de grupo motriz, motor y reductor planetario",
      "Fabricación e instalación de chutes revestidos con placas bimetálicas antiabrasivas",
      "Comisionamiento en vacío y pruebas con carga en Puesta en Marcha (PEM)"
    ]
  },
  {
    id: "proy-quintero",
    code: "OBRA-05",
