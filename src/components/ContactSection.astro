---
const contactInfo = {
  company: "EC Ingeniería",
  email: "contacto@ecingenieria.cl",
  phone: "+56 9 2093 7495",
  phoneRaw: "+56920937495",
  location: "Cobertura Nacional, Chile (Despliegue en Faena)",
  hours: "Lunes a Viernes: 08:30 - 18:30 hrs • Emergencias 24/7",
};
---

<section id="contacto" class="py-16 lg:py-22 bg-white relative border-t border-slate-200/80">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-12">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      
      <!-- Left Column: Corporate Information & Quick Direct Contacts -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-[#F07218]/10 border border-[#F07218]/25 text-[#D95D07] font-mono-tech font-bold text-[11px] uppercase tracking-wider mb-3">
            <span class="w-2 h-2 rounded-full bg-[#F07218]"></span>
            <span>EC INGENIERÍA // LICITACIONES & CONTACTO B2B</span>
          </div>

          <div class="flex items-center gap-3.5 mb-4">
            <span class="w-[6px] h-9 bg-[#F07218] rounded-sm"></span>
            <h2 class="font-heading font-extrabold text-2xl sm:text-3xl lg:text-4xl text-[#081C36] tracking-tight">
              Iniciemos su Próximo Proyecto Industrial
            </h2>
          </div>

          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-8">
            Envíenos sus bases de licitación (RFP), planos de ingeniería, memorias de cálculo o solicite una visita técnica a terreno del equipo de <strong>EC Ingeniería</strong> en cualquier región del país.
          </p>

          <!-- Direct Corporate Cards -->
          <div class="space-y-4">
            <!-- Email Direct Card -->
            <a
              href={`mailto:${contactInfo.email}`}
              class="card-engineered flex items-center gap-4 p-4 rounded-xl group"
            >
              <div class="w-12 h-12 rounded-xl bg-[#081C36] text-[#F07218] flex items-center justify-center shrink-0 group-hover:bg-[#F07218] group-hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              </div>
              <div class="overflow-hidden">
                <div class="text-[11px] font-mono-tech font-bold text-slate-400 uppercase tracking-wider">Canal Oficial de Licitaciones</div>
                <div class="text-sm sm:text-base font-mono-tech font-bold text-[#081C36] group-hover:text-[#F07218] truncate transition-colors">
                  {contactInfo.email}
                </div>
              </div>
            </a>

            <!-- Phone / WhatsApp Direct Card -->
            <a
              href={`https://wa.me/${contactInfo.phoneRaw.replace('+', '')}?text=Hola%20EC%20Ingenier%C3%ADa,%20solicito%20informaci%C3%B3n%20para%20cotizar%20un%20proyecto%20industrial.`}
              target="_blank"
              rel="noopener noreferrer"
              class="card-engineered flex items-center gap-4 p-4 rounded-xl group"
            >
              <div class="w-12 h-12 rounded-xl bg-[#081C36] text-[#F07218] flex items-center justify-center shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.3z"/>
                </svg>
              </div>
              <div class="overflow-hidden">
                <div class="text-[11px] font-mono-tech font-bold text-slate-400 uppercase tracking-wider">Teléfono & WhatsApp Corporativo</div>
                <div class="text-sm sm:text-base font-mono-tech font-bold text-[#081C36] group-hover:text-emerald-600 transition-colors">
                  {contactInfo.phone}
                </div>
              </div>
            </a>

            <!-- Location Card -->
            <div class="card-engineered flex items-center gap-4 p-4 rounded-xl">
              <div class="w-12 h-12 rounded-xl bg-[#081C36] text-[#F07218] flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>
                </svg>
              </div>
              <div>
                <div class="text-[11px] font-mono-tech font-bold text-slate-400 uppercase tracking-wider">Alcance Operativo</div>
                <div class="text-sm sm:text-base font-bold text-[#081C36]">
                  {contactInfo.location}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-200/80 flex items-center justify-between gap-3 text-xs text-slate-500">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0 animate-pulse"></span>
            <span class="font-semibold text-[#081C36]">EC Ingeniería — Atención a Mandantes en todo Chile</span>
          </div>
          <span class="font-mono-tech text-[11px] text-slate-400">SLA &lt; 24h</span>
        </div>
      </div>

      <!-- Right Column: Interactive Quotation Form -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl bg-carbon-steel text-white p-7 sm:p-10 shadow-2xl border border-white/15 relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#F07218]/15 rounded-full blur-3xl pointer-events-none"></div>

          <div class="relative z-10 mb-7 pb-4 border-b border-white/12 flex flex-wrap items-center justify-between gap-3">
            <div>
              <span class="font-mono-tech text-[10.5px] font-bold uppercase tracking-widest text-[#F07218]">
                FORMULARIO TÉCNICO B2B // EC INGENIERÍA
              </span>
              <h3 class="font-heading font-extrabold text-2xl text-white mt-0.5">
                Solicitud de Cotización y Licitaciones
              </h3>
            </div>
            <button
              type="button"
              data-open-ai-agent
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-[#F07218] border border-white/15 text-xs font-mono-tech font-bold text-amber-300 hover:text-white transition-colors"
            >
              <span>⚡ Autocompletar con IA</span>
            </button>
          </div>

          <form id="quote-form" class="relative z-10 space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Nombre y Cargo *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Ej: Jefe de Proyectos / Ingeniero de Planta"
                  class="w-full px-4 py-3 rounded-xl bg-white/[0.08] border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-[#F07218] focus:ring-1 focus:ring-[#F07218] transition-all"
                />
              </div>

              <div>
                <label for="company" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Empresa / Mandante *
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  placeholder="Ej: Compañía Minera / Planta Industrial"
                  class="w-full px-4 py-3 rounded-xl bg-white/[0.08] border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-[#F07218] focus:ring-1 focus:ring-[#F07218] transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="email" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Correo Corporativo *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="contacto@empresa.cl"
                  class="w-full px-4 py-3 rounded-xl bg-white/[0.08] border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-[#F07218] focus:ring-1 focus:ring-[#F07218] transition-all"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Teléfono / WhatsApp *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="+56 9 ..."
                  class="w-full px-4 py-3 rounded-xl bg-white/[0.08] border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-[#F07218] focus:ring-1 focus:ring-[#F07218] transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="service" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Especialidad Requerida
                </label>
                <select
                  id="service"
                  name="service"
                  class="w-full px-4 py-3 rounded-xl bg-[#0D284A] border border-white/20 text-white text-sm focus:outline-none focus:border-[#F07218] focus:ring-1 focus:ring-[#F07218] transition-all"
                >
                  <option value="Ingeniería y Desarrollo de Proyectos">Ingeniería y Desarrollo de Proyectos</option>
                  <option value="Montaje Industrial y Electromecánico">Montaje Industrial y Electromecánico</option>
                  <option value="Fabricación y Montaje de Estructuras">Fabricación y Montaje de Estructuras</option>
                  <option value="Piping e Instalaciones Industriales">Piping e Instalaciones Industriales</option>
                  <option value="Electricidad e Instrumentación">Electricidad e Instrumentación</option>
                  <option value="Mantenimiento Industrial">Mantenimiento Industrial y Paradas de Planta</option>
                  <option value="Proyecto Integral Llave en Mano">Proyecto Integral EPC Llave en Mano</option>
                </select>
              </div>

              <div>
                <label for="location" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Ubicación de Faena / Región
                </label>
                <input
                  type="text"
                  id="location"
                  name="location"
                  placeholder="Ej: Antofagasta, Atacama, Valparaíso, RM, Biobío..."
                  class="w-full px-4 py-3 rounded-xl bg-white/[0.08] border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-[#F07218] focus:ring-1 focus:ring-[#F07218] transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="request_type" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Modalidad de Solicitud
                </label>
                <select
                  id="request_type"
                  name="request_type"
                  class="w-full px-4 py-3 rounded-xl bg-[#0D284A] border border-white/20 text-white text-sm focus:outline-none focus:border-[#F07218] focus:ring-1 focus:ring-[#F07218] transition-all"
                >
                  <option value="Licitación / Bases Técnicas (RFP)">Licitación / Bases Técnicas (RFP)</option>
                  <option value="Cotización de Proyecto Industrial">Cotización de Proyecto Industrial</option>
                  <option value="Visita Técnica a Terreno">Solicitud de Visita Técnica a Terreno</option>
                  <option value="Parada de Planta / Emergencia 24/7">Parada de Planta / Emergencia 24/7</option>
                </select>
              </div>

              <div>
                <label for="files_url" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Enlace a Planos / Bases (Opcional)
                </label>
                <input
                  type="url"
                  id="files_url"
                  name="files_url"
                  placeholder="Drive, WeTransfer, SharePoint..."
                  class="w-full px-4 py-3 rounded-xl bg-white/[0.08] border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-[#F07218] focus:ring-1 focus:ring-[#F07218] transition-all"
                />
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-300 mb-2">
                Descripción del Requerimiento o Alcance Técnico *
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Indique detalles de la obra, magnitudes estimadas (tonelaje, metros lineales, equipos), plazos o requerimiento de visita técnica..."
                class="w-full px-4 py-3 rounded-xl bg-white/[0.08] border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:border-[#F07218] focus:ring-1 focus:ring-[#F07218] transition-all resize-y"
              ></textarea>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row items-center gap-4">
              <button
                type="submit"
                id="submit-quote-btn"
                class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-xl bg-gradient-to-b from-[#F58220] to-[#DC5B04] hover:from-[#FF8F33] hover:to-[#E8660C] text-white font-heading font-bold text-sm uppercase tracking-wider shadow-[0_6px_20px_rgba(240,114,24,0.4)] hover:shadow-[0_8px_25px_rgba(240,114,24,0.6)] active:scale-[0.98] transition-all"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
                <span id="submit-quote-text">Enviar Solicitud a EC Ingeniería</span>
              </button>

              <button
                type="button"
                id="whatsapp-direct-btn"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-heading font-bold text-sm uppercase tracking-wider transition-all shadow-md"
              >
                <span>WhatsApp Directo</span>
              </button>
            </div>

            <div id="form-feedback" class="hidden p-4 rounded-xl text-xs font-semibold text-center"></div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-quote-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('submit-quote-text');
  const waBtn = document.getElementById('whatsapp-direct-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name');
    const company = data.get('company');
    const email = data.get('email');
    const phone = data.get('phone');
    const service = data.get('service');
    const location = data.get('location') || 'Cobertura Nacional';
    const requestType = data.get('request_type') || 'Cotización Industrial';
    const filesUrl = data.get('files_url') || 'No adjunto';
    const message = data.get('message');

    if (submitBtn && submitText) {
      submitBtn.disabled = true;
      submitText.textContent = 'Enviando requerimiento a EC Ingeniería...';
    }

    const subject = `[EC Ingeniería] ${requestType}: ${service} - ${company}`;
    const bodyText =
      `Equipo de Ingeniería y Licitaciones — EC Ingeniería,\n\nSe ha generado una nueva solicitud técnica desde el portal corporativo:\n\n` +
      `• Modalidad: ${requestType}\n` +
      `• Contacto: ${name}\n` +
      `• Empresa / Mandante: ${company}\n` +
      `• Correo: ${email}\n` +
      `• Teléfono: ${phone}\n` +
      `• Especialidad: ${service}\n` +
      `• Ubicación de Obra: ${location}\n` +
      `• Enlace a Planos / Bases: ${filesUrl}\n\n` +
      `Alcance Técnico / Requerimiento:\n${message}\n\n` +
      `Enviado desde ecingenieria.cl`;

    try {
      const response = await fetch('https://formsubmit.co/ajax/contacto@ecingenieria.cl', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({
          _subject: subject,
          Empresa_Destino: 'EC Ingeniería',
          Tipo_Requerimiento: requestType,
          Nombre_Contacto: name,
          Empresa_Mandante: company,
          Email: email,
          Telefono: phone,
          Especialidad: service,
          Ubicacion_Obra: location,
          Link_Planos_Bases: filesUrl,
          Mensaje_Tecnico: message,
        }),
      });

      if (response.ok && feedback) {
        feedback.className = 'p-4 rounded-xl text-xs font-semibold text-center bg-emerald-500/20 text-emerald-200 border border-emerald-500/40 block';
        feedback.innerHTML = `✓ Solicitud recepcionada por <strong>EC Ingeniería</strong> (<strong>contacto@ecingenieria.cl</strong>). También puede <a href="mailto:contacto@ecingenieria.cl?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyText)}" class="underline font-bold text-white">descargar copia directa en su correo aquí</a>.`;
        form.reset();
      } else {
        throw new Error('Fallback to mailto');
      }
    } catch {
      window.location.href = `mailto:contacto@ecingenieria.cl?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyText)}`;
      if (feedback) {
        feedback.className = 'p-4 rounded-xl text-xs font-semibold text-center bg-emerald-500/20 text-emerald-200 border border-emerald-500/40 block';
        feedback.textContent = '✓ Abriendo su cliente de correo para enviar directamente a EC Ingeniería (contacto@ecingenieria.cl)...';
      }
    } finally {
      if (submitBtn && submitText) {
        submitBtn.disabled = false;
        submitText.textContent = 'Enviar Solicitud a EC Ingeniería';
      }
    }
  });

  waBtn?.addEventListener('click', () => {
    const data = form ? new FormData(form) : null;
    const name = data?.get('name') || '';
    const company = data?.get('company') || '';
    const service = data?.get('service') || 'Ingeniería Industrial';
    const requestType = data?.get('request_type') || 'Cotización';
    const message = data?.get('message') || '';

    const text = encodeURIComponent(
      `Hola EC Ingeniería, nos contactamos desde el portal corporativo:\n` +
      `• Modalidad: ${requestType}\n` +
      `• Contacto: ${name || 'Representante Técnico'}\n` +
      `• Empresa: ${company || 'Mandante Industrial'}\n` +
      `• Especialidad: ${service}\n` +
      (message ? `• Alcance: ${message}` : '')
    );

    window.open(`https://wa.me/56920937495?text=${text}`, '_blank');
  });
</script>
