---
---

<section aria-label="Especialidades de Ingeniería Industrial" class="relative z-20 bg-white border-b border-slate-200/90 shadow-[0_12px_34px_rgba(8,28,54,0.07)]">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 divide-y sm:divide-y-0 sm:divide-x divide-slate-200/80">
      
      <!-- 01. Ingeniería y Desarrollo de Proyectos -->
      <a
        href="#servicio-ingenieria"
        class="group relative flex flex-col items-center text-center px-3.5 py-5 hover:bg-slate-50/90 transition-all overflow-hidden"
      >
        <span class="absolute top-0 inset-x-0 h-[3px] bg-[#F07218] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
        <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-[#081C36]/[0.05] to-[#F07218]/[0.1] group-hover:from-[#081C36] group-hover:to-[#0E2A4F] border border-slate-200/90 group-hover:border-[#F07218] flex items-center justify-center text-[#F07218] mb-3 transition-all duration-300 group-hover:-translate-y-1 shadow-sm group-hover:shadow-md">
          <!-- CAD Isometric Cube + Caliper Vector Icon -->
          <svg class="w-8 h-8" viewBox="0 0 48 48" fill="none">
            <polygon points="24 7 40 16 40 32 24 41 8 32 8 16 24 7" fill="currentColor" fill-opacity="0.15" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />
            <path d="M8 16l16 9 16-9M24 25v16" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="24" cy="16" r="2.5" fill="currentColor" />
          </svg>
          <span class="absolute -top-1.5 -right-1.5 px-1.5 py-0.5 rounded bg-[#081C36] group-hover:bg-[#F07218] text-white font-mono-tech font-bold text-[9px] tracking-wider shadow-sm transition-colors">01</span>
        </div>
        <h2 class="font-heading font-extrabold text-[13px] text-[#081C36] group-hover:text-[#F07218] leading-snug transition-colors">
          Ingeniería y<br />Desarrollo de Proyectos
        </h2>
        <span class="mt-1.5 font-mono-tech text-[10px] font-semibold text-slate-400 group-hover:text-[#081C36] transition-colors">
          NCh 2369 • CAD 3D
        </span>
      </a>

      <!-- 02. Montaje Industrial y Electromecánico -->
      <a
        href="#servicio-montaje"
        class="group relative flex flex-col items-center text-center px-3.5 py-5 hover:bg-slate-50/90 transition-all overflow-hidden"
      >
        <span class="absolute top-0 inset-x-0 h-[3px] bg-[#F07218] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
        <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-[#081C36]/[0.05] to-[#F07218]/[0.1] group-hover:from-[#081C36] group-hover:to-[#0E2A4F] border border-slate-200/90 group-hover:border-[#F07218] flex items-center justify-center text-[#F07218] mb-3 transition-all duration-300 group-hover:-translate-y-1 shadow-sm group-hover:shadow-md">
          <!-- Heavy Rigging Hoist Block & Precision Drive Icon -->
          <svg class="w-8 h-8" viewBox="0 0 48 48" fill="none">
            <rect x="15" y="11" width="18" height="12" rx="2.5" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="2.4" />
            <path d="M20 5v6M28 5v6" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.4" stroke-linecap="round" />
            <circle cx="24" cy="17" r="2.5" fill="currentColor" />
            <path d="M24 23v6c0 3.5 3.5 6 6.5 4.5 2.2-1.1 2.5-4.2.5-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M9 41h30" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="4 4" />
          </svg>
          <span class="absolute -top-1.5 -right-1.5 px-1.5 py-0.5 rounded bg-[#081C36] group-hover:bg-[#F07218] text-white font-mono-tech font-bold text-[9px] tracking-wider shadow-sm transition-colors">02</span>
        </div>
        <h2 class="font-heading font-extrabold text-[13px] text-[#081C36] group-hover:text-[#F07218] leading-snug transition-colors">
          Montaje Industrial<br />y Electromecánico
        </h2>
        <span class="mt-1.5 font-mono-tech text-[10px] font-semibold text-slate-400 group-hover:text-[#081C36] transition-colors">
          Rigging • Alineamiento
        </span>
      </a>

      <!-- 03. Fabricación y Montaje de Estructuras Metálicas -->
      <a
        href="#servicio-estructuras"
        class="group relative flex flex-col items-center text-center px-3.5 py-5 hover:bg-slate-50/90 transition-all overflow-hidden"
      >
        <span class="absolute top-0 inset-x-0 h-[3px] bg-[#F07218] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
        <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-[#081C36]/[0.05] to-[#F07218]/[0.1] group-hover:from-[#081C36] group-hover:to-[#0E2A4F] border border-slate-200/90 group-hover:border-[#F07218] flex items-center justify-center text-[#F07218] mb-3 transition-all duration-300 group-hover:-translate-y-1 shadow-sm group-hover:shadow-md">
          <!-- Structural Steel I-Beam & Gusset Plate Icon -->
          <svg class="w-8 h-8" viewBox="0 0 48 48" fill="none">
            <polygon points="10 14 26 8 38 12 22 18 10 14" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" />
            <path d="M10 14v5l6 2v11l-6 2v5l12 4v-5l-4-1.5V19.5l4 1.5v-3" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M22 43l16-6v-5l-6-2V19l6-2v-5" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="22" y1="21" x2="32" y2="17" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            <line x1="22" y1="36" x2="32" y2="32" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
          <span class="absolute -top-1.5 -right-1.5 px-1.5 py-0.5 rounded bg-[#081C36] group-hover:bg-[#F07218] text-white font-mono-tech font-bold text-[9px] tracking-wider shadow-sm transition-colors">03</span>
        </div>
        <h2 class="font-heading font-extrabold text-[13px] text-[#081C36] group-hover:text-[#F07218] leading-snug transition-colors">
          Fabricación y Montaje<br />de Estructuras Metálicas
        </h2>
        <span class="mt-1.5 font-mono-tech text-[10px] font-semibold text-slate-400 group-hover:text-[#081C36] transition-colors">
          AWS D1.1 • Ensayos END
        </span>
      </a>

      <!-- 04. Piping e Instalaciones Industriales -->
      <a
        href="#servicio-piping"
        class="group relative flex flex-col items-center text-center px-3.5 py-5 hover:bg-slate-50/90 transition-all overflow-hidden"
      >
        <span class="absolute top-0 inset-x-0 h-[3px] bg-[#F07218] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
        <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-[#081C36]/[0.05] to-[#F07218]/[0.1] group-hover:from-[#081C36] group-hover:to-[#0E2A4F] border border-slate-200/90 group-hover:border-[#F07218] flex items-center justify-center text-[#F07218] mb-3 transition-all duration-300 group-hover:-translate-y-1 shadow-sm group-hover:shadow-md">
          <!-- High-Pressure Flanged Spool & OS&Y Valve Icon -->
          <svg class="w-8 h-8" viewBox="0 0 48 48" fill="none">
            <rect x="12" y="25" width="24" height="9" fill="currentColor" fill-opacity="0.16" />
            <ellipse cx="24" cy="11.5" rx="9" ry="3.5" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.4" />
            <line x1="24" y1="15" x2="24" y2="23" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.4" stroke-linecap="round" />
            <line x1="19" y1="19" x2="29" y2="19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
            <rect x="7" y="23.5" width="4.5" height="12" rx="1" stroke="currentColor" stroke-width="2.4" />
            <rect x="36.5" y="23.5" width="4.5" height="12" rx="1" stroke="currentColor" stroke-width="2.4" />
            <line x1="11.5" y1="25.5" x2="36.5" y2="25.5" stroke="currentColor" stroke-width="2.4" />
            <line x1="11.5" y1="33.5" x2="20" y2="33.5" stroke="currentColor" stroke-width="2.4" />
            <line x1="28" y1="33.5" x2="36.5" y2="33.5" stroke="currentColor" stroke-width="2.4" />
            <line x1="20" y1="33.5" x2="20" y2="40" stroke="currentColor" stroke-width="2.4" />
            <line x1="28" y1="33.5" x2="28" y2="40" stroke="currentColor" stroke-width="2.4" />
            <rect x="17.5" y="40" width="13" height="3.5" rx="1" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.2" />
          </svg>
          <span class="absolute -top-1.5 -right-1.5 px-1.5 py-0.5 rounded bg-[#081C36] group-hover:bg-[#F07218] text-white font-mono-tech font-bold text-[9px] tracking-wider shadow-sm transition-colors">04</span>
        </div>
        <h2 class="font-heading font-extrabold text-[13px] text-[#081C36] group-hover:text-[#F07218] leading-snug transition-colors">
          Piping e Instalaciones<br />Industriales
        </h2>
        <span class="mt-1.5 font-mono-tech text-[10px] font-semibold text-slate-400 group-hover:text-[#081C36] transition-colors">
          ASME B31.3 • Red NFPA
        </span>
      </a>

      <!-- 05. Electricidad e Instrumentación -->
      <a
        href="#servicio-electricidad"
        class="group relative flex flex-col items-center text-center px-3.5 py-5 hover:bg-slate-50/90 transition-all overflow-hidden"
      >
        <span class="absolute top-0 inset-x-0 h-[3px] bg-[#F07218] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
        <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-[#081C36]/[0.05] to-[#F07218]/[0.1] group-hover:from-[#081C36] group-hover:to-[#0E2A4F] border border-slate-200/90 group-hover:border-[#F07218] flex items-center justify-center text-[#F07218] mb-3 transition-all duration-300 group-hover:-translate-y-1 shadow-sm group-hover:shadow-md">
          <!-- Industrial Power & Control Loop Icon -->
          <svg class="w-8 h-8" viewBox="0 0 48 48" fill="none">
            <circle cx="24" cy="24" r="12" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="2.4" />
            <path d="M24 7v4m0 26v4M7 24h4m26 0h4m-29-12 3 3m18 18 3 3m0-24-3 3M15 33l-3 3" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.4" stroke-linecap="round" />
            <polygon points="25.5 15 18.5 25 23.8 25 22.5 33 29.5 23 24.2 23 25.5 15" fill="currentColor" />
          </svg>
          <span class="absolute -top-1.5 -right-1.5 px-1.5 py-0.5 rounded bg-[#081C36] group-hover:bg-[#F07218] text-white font-mono-tech font-bold text-[9px] tracking-wider shadow-sm transition-colors">05</span>
        </div>
        <h2 class="font-heading font-extrabold text-[13px] text-[#081C36] group-hover:text-[#F07218] leading-snug transition-colors">
          Electricidad e<br />Instrumentación
        </h2>
        <span class="mt-1.5 font-mono-tech text-[10px] font-semibold text-slate-400 group-hover:text-[#081C36] transition-colors">
          SEC Pliegos RIC • CCM
        </span>
      </a>

      <!-- 06. Mantenimiento Industrial -->
      <a
        href="#servicio-mantenimiento"
        class="group relative flex flex-col items-center text-center px-3.5 py-5 hover:bg-slate-50/90 transition-all overflow-hidden"
      >
        <span class="absolute top-0 inset-x-0 h-[3px] bg-[#F07218] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
        <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-[#081C36]/[0.05] to-[#F07218]/[0.1] group-hover:from-[#081C36] group-hover:to-[#0E2A4F] border border-slate-200/90 group-hover:border-[#F07218] flex items-center justify-center text-[#F07218] mb-3 transition-all duration-300 group-hover:-translate-y-1 shadow-sm group-hover:shadow-md">
          <!-- Heavy Plant Maintenance & Reliability Icon -->
          <svg class="w-8 h-8" viewBox="0 0 48 48" fill="none">
            <path d="M14.5 10.5a7.5 7.5 0 0 0 9.6 9.6l11.4 11.4a3 3 0 0 1-4.2 4.2L19.9 24.3a7.5 7.5 0 0 1-9.6-9.6l4.2 4.2 3.8-1.2 1.2-3.8-5-3.4z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            <path d="m36 10-6 6 2 2 6-6-2-2z" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="m31 15-19 19a3 3 0 0 0 4.2 4.2l19-19" stroke="#081C36" class="group-hover:stroke-white transition-colors" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="absolute -top-1.5 -right-1.5 px-1.5 py-0.5 rounded bg-[#081C36] group-hover:bg-[#F07218] text-white font-mono-tech font-bold text-[9px] tracking-wider shadow-sm transition-colors">06</span>
        </div>
        <h2 class="font-heading font-extrabold text-[13px] text-[#081C36] group-hover:text-[#F07218] leading-snug transition-colors">
          Mantenimiento<br />y Paradas de Planta
        </h2>
        <span class="mt-1.5 font-mono-tech text-[10px] font-semibold text-slate-400 group-hover:text-[#081C36] transition-colors">
          Shutdowns • LOTO 24/7
        </span>
      </a>

    </div>
  </div>
</section>
